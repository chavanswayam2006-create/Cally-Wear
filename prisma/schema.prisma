// Prisma schema for Cally Wear
// Matches Section 3 of backend spec

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id            String    @id // matches Supabase auth.users.id
  email         String    @unique
  fullName      String?
  phone         String?
  role          Role      @default(CUSTOMER)
  passwordHash  String?   // Used by local auth shim when not using external Supabase Auth
  addresses     Address[]
  orders        Order[]
  createdAt     DateTime  @default(now())
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model Address {
  id          String   @id @default(cuid())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  label       String?  // "Home", "Work"
  line1       String
  line2       String?
  city        String
  state       String
  pincode     String
  phone       String
  isDefault   Boolean  @default(false)

  @@index([profileId])
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  sku             String           @unique
  description     String
  materials       String
  basePrice       Decimal
  salePrice       Decimal?
  isOnSale        Boolean          @default(false)
  discountPercent Int?             // derived/stored for display convenience
  isFeatured      Boolean          @default(false)
  isNewArrival    Boolean          @default(false)
  status          ProductStatus    @default(DRAFT) // DRAFT products never show on storefront
  images          ProductImage[]
  variants        ProductVariant[]
  sections        ProductSection[]
  orderItems      OrderItem[]
  scrollShowcaseItems ScrollShowcaseItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([isOnSale])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ProductImage {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  url         String   // Supabase Storage URL
  altText     String?
  sortOrder   Int      @default(0)

  @@index([productId])
}

model ProductVariant {
  id          String      @id @default(cuid())
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  size        String      // "UK 8", "US 9", etc.
  stock       Int         @default(0)
  orderItems  OrderItem[]

  @@index([productId])
}

model Section {
  id          String           @id @default(cuid())
  name        String           // "New Arrivals", "Best Sellers", "Sale", "Men", "Women"
  slug        String           @unique
  sortOrder   Int              @default(0)
  products    ProductSection[]
}

model ProductSection {
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId   String

  @@id([productId, sectionId])
  @@index([productId])
  @@index([sectionId])
}

model Order {
  id              String             @id @default(cuid())
  orderNumber     String             @unique // human-readable, e.g. CW-100234
  profile         Profile            @relation(fields: [profileId], references: [id])
  profileId       String
  items           OrderItem[]
  shippingAddress Json               // snapshot at time of order, not a live FK
  subtotal        Decimal
  shippingFee     Decimal            @default(0)
  total           Decimal
  status          OrderStatus        @default(PLACED)
  statusHistory   OrderStatusEvent[]
  payment         Payment?
  trackingNumber  String?
  carrier         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([profileId])
  @@index([status])
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  status      OrderStatus
  note        String?
  updatedBy   String      // "system" or admin's profileId
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model OrderItem {
  id              String         @id @default(cuid())
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  product         Product        @relation(fields: [productId], references: [id])
  productId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  variantId       String
  quantity        Int
  priceAtPurchase Decimal        // snapshot — never trust live product price for past orders

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id              String            @id @default(cuid())
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String            @unique
  method          PaymentMethod
  status          PaymentStatus     @default(PENDING)
  amountDue       Decimal
  amountPaid      Decimal           @default(0)
  log             PaymentLogEvent[]
  updatedAt       DateTime          @updatedAt
}

enum PaymentMethod {
  COD
  PREPAID_MOCK
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
}

model PaymentLogEvent {
  id          String        @id @default(cuid())
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId   String
  amount      Decimal
  status      PaymentStatus
  source      String        // "system" (automated) or admin's profileId (manual)
  note        String?
  createdAt   DateTime      @default(now())

  @@index([paymentId])
}

model ScrollShowcaseItem {
  id                   String   @id @default(cuid())
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId            String
  displayOrder         Int      @default(0)
  isActive             Boolean  @default(true)
  overrideImageUrl     String?
  highlightLabel       String   // e.g. "NITROGEN-INJECTED FOAM"
  highlightDescription String   // Chapter supporting copy
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([productId])
  @@index([isActive, displayOrder])
}
